# Production environment template. Copy to your host's secret store (do NOT commit a filled copy).
# The app refuses to boot if DEV_ALLOW_NO_AUTH is true while APP_ENV is not development.

APP_ENV=production
DEV_ALLOW_NO_AUTH=false

# CORS: the exact origin(s) your site is served from (comma-separated). Required in production.
ALLOWED_ORIGINS=https://covered.example.com

# Auth (Clerk) — REQUIRED in production, or every authenticated endpoint returns 401.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=

# Database (managed SurrealDB, e.g. Surreal Cloud, or your own instance).
# No server? SURREAL_URL=mem:// (resets on restart) or surrealkv://data/covered.db (persistent file)
# runs SurrealDB embedded in the app. Embedded mode is single-process: set WEB_CONCURRENCY=1.
SURREAL_URL=wss://your-surreal-host/rpc
SURREAL_USER=
SURREAL_PASS=
SURREAL_NS=covered
SURREAL_DB=covered

# LLM (co-pilots + plain-language explanations). Without it, those degrade to deterministic text.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku

# Voice speech-to-text (optional; voice is demoted to an option).
COHERE_API_KEY=

# Natural text-to-speech (optional). Without a key the UI uses the robotic browser voice.
# ElevenLabs is the most human-sounding; set the key to turn it on.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5
# Or use OpenAI TTS instead (a direct OpenAI key, not OpenRouter):
OPENAI_API_KEY=
OPENAI_TTS_VOICE=shimmer

# Partner embed API: comma-separated issued keys (the demo key is never accepted in production).
PARTNER_API_KEYS=

# SurrealDB Agent Memory (Spectron): time-aware policy-fact store (optional; policy facts only).
SPECTRON_URL=
SPECTRON_CONTEXT_ID=
SPECTRON_API_KEY=

# Worker processes (uvicorn). Tune to your host's CPU.
WEB_CONCURRENCY=2
