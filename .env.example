# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- AI / voice (app runs without these via graceful degradation) ---
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# --- LLM provider (OpenRouter, OpenAI-compatible) — powers the ops co-pilot + explanations ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# any OpenRouter id: openai/gpt-4o-mini (cheap) | anthropic/claude-3.5-haiku | google/gemini-2.0-flash-001
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Clerk (authentication) ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_KEY=

# --- SurrealDB ---
SURREAL_URL=ws://surrealdb:8000/rpc
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=covered
SURREAL_DB=covered

# --- app ---
APP_ENV=development
# When true, unauthenticated requests get a dev identity (LOCAL DEV ONLY).
DEV_ALLOW_NO_AUTH=true
